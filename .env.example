# OnlyDrinks Environment Configuration
# Copy this file to .env and fill in your values

# Spring Profile
# Options: dev (H2 in-memory), prod (PostgreSQL + Valkey)
SPRING_PROFILES_ACTIVE=dev

# Application Port
APP_PORT=80
APP_SSL_PORT=443

# Database Configuration (Production only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onlydrinks
DB_USERNAME=onlydrinks
DB_PASSWORD=changeme
SSL_KEYSTORE_PASSWORD=changeme

# Docker Compose will use these values
# Make sure to set DB_PASSWORD before running docker-compose
