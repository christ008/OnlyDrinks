# OnlyDrinks Environment Configuration
# Copy this file to .env and fill in your values

# Spring Profile
# Options: dev (H2), prod (PostgreSQL + TLS + nginx)
SPRING_PROFILES_ACTIVE=prod

# Application Port
APP_PORT=80
APP_SSL_PORT=443

# Database Configuration (Production only)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=onlydrinks
DB_USERNAME=onlydrinks
DB_PASSWORD=
SSL_KEYSTORE_PASSWORD=

# Production admin bootstrap (required when BOOTSTRAP_ADMIN_ENABLED=true)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=OnlyDrinks Admin
BOOTSTRAP_ADMIN_PASSWORD=

# Docker Compose and cert scripts use these values.
# Keep .env permissions restrictive: chmod 600 .env
